#!/bin/bash
# Generated by mkconfig-core.sh. Disk health alerting + jewel backup.

ALERT_EMAIL="y@gour.top"
SMTP_RELAY_HOST="192.168.0.235"
SMTP_RELAY_PORT="25"
MAIL_FROM="root@manin.gour.top"
MAIL_EHLO_DOMAIN="manin.gour.top"
JEWEL_ENABLE="true"
JEWEL_DEST="zbulk/backup"
JEWEL_DATASETS="zroot/data/immich zroot/data/immich01 zroot/data/immich02 zroot/data/lxcfs/immich zroot/data/smbfs zroot/data/androidfs zroot/data/whatsapp zroot/data/dossierGraph zroot/data/cubecallACR zroot/data/callgraph zroot/data/taxgraph zroot/data/zbackup-salvage"
JEWEL_STRIP_PREFIX="zroot/data/"
JEWEL_ONCALENDAR="*-*-* 04:30:00 UTC"
JEWEL_KEEP_SRC="3"
JEWEL_KEEP_DST="30"

# ---------------------------------------------------------------------------
# Mail relay. The image ships no local MTA, so smartd alerts are relayed to a
# smarthost via msmtp. Debian's /etc/smartmontools/run.d/10mail calls
# /usr/bin/mail (bsd-mailx), NOT /usr/sbin/sendmail -- both packages are
# installed, or smartd raises alerts that go nowhere.
# ---------------------------------------------------------------------------
mkdir -p /etc/systemd/system

if [ -n "$ALERT_EMAIL" ] && [ -n "$SMTP_RELAY_HOST" ]; then
  cat > /etc/msmtprc <<MSMTPEOF
defaults
auth off
tls off
logfile /var/log/msmtp.log
# EHLO must be an FQDN. A bare hostname is rejected by strict MTAs with
# "550 Invalid EHLO domain" and every alert is lost silently.
domain ${MAIL_EHLO_DOMAIN}

account smarthost
host ${SMTP_RELAY_HOST}
port ${SMTP_RELAY_PORT}
from ${MAIL_FROM}

account default : smarthost
aliases /etc/aliases
MSMTPEOF
  chmod 0644 /etc/msmtprc

  touch /etc/aliases
  if ! grep -q '^root:' /etc/aliases; then
    printf 'root: %s\ndefault: %s\n' "$ALERT_EMAIL" "$ALERT_EMAIL" >> /etc/aliases
  fi

  # Generic failure notifier, wired via OnFailure= on scheduled units.
  cat > /usr/local/sbin/systemd-email <<'MAILEREOF'
#!/bin/bash
# Emails a systemd unit failure. Used via OnFailure=status-email@%n.service.
to="$1"; unit="$2"
/usr/bin/mail -s "[$(hostname -s)] systemd unit FAILED: ${unit}" "$to" <<MSG
Unit: ${unit}
Host: $(hostname -f 2>/dev/null || hostname)
Time: $(date -u +%FT%TZ)

$(systemctl status --full --no-pager "${unit}" 2>&1 | head -30)

--- last 30 log lines ---
$(journalctl -u "${unit}" -n 30 --no-pager 2>&1)
MSG
MAILEREOF
  chmod 0755 /usr/local/sbin/systemd-email

  cat > /etc/systemd/system/status-email@.service <<STATUSEOF
[Unit]
Description=Email systemd unit failure for %i

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/systemd-email ${ALERT_EMAIL} %i
User=root
STATUSEOF
fi

# ---------------------------------------------------------------------------
# smartd. DEVICESCAN applies one directive set to every detected disk, so the
# image stays hardware independent.
#   -R 5/197/198  mail when reallocated / pending / offline-uncorrectable RAW
#                 counts GROW. Growth is the early warning; waiting for the
#                 normalized value to cross its threshold is far too late.
#   -R 199        mail when UDMA CRC errors grow -- that is a SATA cable, not
#                 the platter. A static historical count is harmless.
#   -I 194 -I 190 drop temperature attributes from change tracking (noise);
#                 -W gives explicit thresholds instead and only mails at 60C.
#   -n standby,q  never spin a sleeping disk up just to poll it.
# ---------------------------------------------------------------------------
if [ -n "$ALERT_EMAIL" ]; then
  SMART_MAIL="-m $ALERT_EMAIL -M exec /usr/share/smartmontools/smartd-runner"
else
  SMART_MAIL=""
fi
cat > /etc/smartd.conf <<SMARTEOF
# Managed by yggdrasil (hook 9110). Local edits are overwritten on rebuild.
DEVICESCAN -a -o on -S on -n standby,q -R 5 -R 197 -R 198 -R 199 -I 194 -I 190 -W 4,50,60 -s (S/../.././02|L/../01/./03) ${SMART_MAIL}
SMARTEOF
systemctl enable smartmontools.service >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# Jewel backup: incremental ZFS replication to a second pool.
# ---------------------------------------------------------------------------
mkdir -p /etc/yggdrasil
cat > /etc/yggdrasil/jewel-backup.conf <<JCONFEOF
# Consumed by /usr/local/sbin/jewel-backup.sh
DESTROOT="${JEWEL_DEST}"
JEWEL_DATASETS="${JEWEL_DATASETS}"
SRC_STRIP_PREFIX="${JEWEL_STRIP_PREFIX}"
KEEP_SRC="${JEWEL_KEEP_SRC}"
KEEP_DST="${JEWEL_KEEP_DST}"
JCONFEOF

cat > /usr/local/sbin/jewel-backup.sh <<'JEWELEOF'
#!/bin/bash
# Incremental ZFS replication of irreplaceable datasets onto a second pool.
# Full `zfs send -R` on the first run per dataset, `-I` incrementals after.
# Received copies inherit mountpoint=none and readonly=on from the destination
# root, so a backup can never shadow or be mistaken for the live dataset.
set -uo pipefail

CONF=/etc/yggdrasil/jewel-backup.conf
if [ ! -r "$CONF" ]; then
  echo "jewel-backup: missing config $CONF" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$CONF"

DESTROOT="${DESTROOT:-}"
STRIP_PREFIX="${SRC_STRIP_PREFIX:-}"
KEEP_SRC="${KEEP_SRC:-3}"
KEEP_DST="${KEEP_DST:-30}"
LOG=/var/log/jewel-backup.log

log(){ echo "$(date -u +%FT%TZ) $*" | tee -a "$LOG"; }

if [ -z "$DESTROOT" ]; then
  echo "jewel-backup: DESTROOT not set in $CONF" >&2
  exit 1
fi

read -r -a JEWELS <<< "${JEWEL_DATASETS:-}"
# Explicit dataset arguments override the configured list (used to retry one).
if [ "$#" -ge 1 ]; then JEWELS=("$@"); fi
if [ "${#JEWELS[@]}" -eq 0 ]; then
  echo "jewel-backup: no datasets configured" >&2
  exit 0
fi

if ! zfs list -H -o name "$DESTROOT" >/dev/null 2>&1; then
  log "ERR destination root $DESTROOT does not exist"
  exit 1
fi

SNAP="jewel-$(date -u +%Y%m%d-%H%M%SZ)"
fail=0

for SRC in "${JEWELS[@]}"; do
  if ! zfs list -H -o name "$SRC" >/dev/null 2>&1; then
    log "SKIP $SRC (does not exist)"
    continue
  fi
  DST="$DESTROOT/${SRC#$STRIP_PREFIX}"

  # zfs recv does NOT create intermediate parents: a nested source such as
  # pool/data/lxcfs/immich needs <dest>/lxcfs to exist before the receive.
  DSTPARENT="${DST%/*}"
  if ! zfs list -H -o name "$DSTPARENT" >/dev/null 2>&1; then
    log "create intermediate parent $DSTPARENT"
    if ! zfs create -p -o mountpoint=none "$DSTPARENT"; then
      log "ERR create parent $DSTPARENT"; fail=1; continue
    fi
  fi

  log "snapshot -r $SRC@$SNAP"
  if ! zfs snapshot -r "$SRC@$SNAP"; then
    log "ERR snapshot $SRC"; fail=1; continue
  fi

  if zfs list -H -o name "$DST" >/dev/null 2>&1; then
    # Newest jewel snapshot present on BOTH parents is the incremental base.
    PREV="$(comm -12 \
      <(zfs list -H -o name -t snapshot -r "$SRC" | grep -E "^${SRC}@jewel-" | sed "s#^${SRC}@##" | sort) \
      <(zfs list -H -o name -t snapshot -r "$DST" | grep -E "^${DST}@jewel-" | sed "s#^${DST}@##" | sort) \
      | grep -vx "$SNAP" | tail -1)"
    if [ -z "$PREV" ]; then
      log "ERR no common base snapshot for $SRC -> $DST (needs a manual reseed)"
      fail=1; continue
    fi
    log "incremental $SRC @$PREV..@$SNAP -> $DST"
    if ! zfs send -R -I "@$PREV" "$SRC@$SNAP" | zfs recv -F -u -x mountpoint -x readonly "$DST"; then
      log "ERR incremental recv $SRC -> $DST"; fail=1; continue
    fi
  else
    log "FULL $SRC@$SNAP -> $DST"
    if ! zfs send -R "$SRC@$SNAP" | zfs recv -u -x mountpoint -x readonly "$DST"; then
      log "ERR full recv $SRC -> $DST"; fail=1; continue
    fi
  fi

  # Keep the newest N recursive jewel snapshots on each side; drop the rest.
  zfs list -H -o name -t snapshot -r "$SRC" | grep -E "^${SRC}@jewel-" | sort \
    | head -n "-${KEEP_SRC}" | while read -r s; do zfs destroy -r "$s" 2>>"$LOG"; done
  zfs list -H -o name -t snapshot -r "$DST" | grep -E "^${DST}@jewel-" | sort \
    | head -n "-${KEEP_DST}" | while read -r s; do zfs destroy -r "$s" 2>>"$LOG"; done
done

log "jewel-backup run complete (fail=$fail)"
exit "$fail"
JEWELEOF
chmod 0755 /usr/local/sbin/jewel-backup.sh

cat > /etc/systemd/system/jewel-backup.service <<JSVCEOF
[Unit]
Description=Jewel backup: incremental ZFS replication to a second pool
After=zfs.target
Wants=zfs.target
OnFailure=status-email@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/jewel-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
JSVCEOF

cat > /etc/systemd/system/jewel-backup.timer <<JTIMEREOF
[Unit]
Description=Daily jewel backup

[Timer]
OnCalendar=${JEWEL_ONCALENDAR}
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
JTIMEREOF

systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$JEWEL_ENABLE" = "true" ]; then
  systemctl enable jewel-backup.timer >/dev/null 2>&1 || true
fi
